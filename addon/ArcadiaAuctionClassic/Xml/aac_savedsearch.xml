							</Offset>
						</Anchor>
					</Anchors>
					<TexCoords left="0.25" right="0.75" top="0" bottom="1"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString name="AAC_BrowseSavedSearchTitle" inherits="GameFontYellow" text="saved search">
