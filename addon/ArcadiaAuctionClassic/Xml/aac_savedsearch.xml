	<Button name="AAC_BrowseSavedSearchButtonTemplate" inherits="AAC_BrowseTreeButtonTemplate" virtual="true">
		<Scripts>
			<OnLoad>
				this:RegisterForClicks("LeftButton", "RightButton")
			</OnLoad>
			<OnClick>AAC.SavedSearch.Button_OnClick(this, key)</OnClick>
			<OnDragStart>AAC.SavedSearch.Button_OnDragStart(this)</OnDragStart>
			<OnReceiveDrag>AAC.SavedSearch.Button_OnReceiveDrag(this)</OnReceiveDrag>
			<OnMouseWheel>UIPanelScrollBar_OnMouseWheel(AAC_BrowseSavedSearchScrollBar, delta)</OnMouseWheel>
		</Scripts>
	</Button>

