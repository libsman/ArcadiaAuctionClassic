						<Offset>
							<AbsDimension x="20" y="74"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Backdrop edgeFile="Interface\AuctionFrame\AuctionFrame-Tooltip-Border" bgFile="Interface\AuctionFrame\AuctionFrame-Tooltip-Background">
					<EdgeSize>
						<AbsValue val="16"/>
					</EdgeSize>
					<TileSize>
						<AbsValue val="16"/>
					</TileSize>
					<BackgroundInsets>
						<AbsInset left="16" right="16" top="16" bottom="16"/>
					</BackgroundInsets>
				</Backdrop>
				<Frames>
					<Slider name="AAC_BidListScrollBar" inherits="UIPanelScrollBarHaveBackdropTemplate">
						<Anchors>
							<Anchor point="TOPRIGHT">
								<Offset>
									<AbsDimension x="-6" y="42"/>
								</Offset>
							</Anchor>
							<Anchor point="BOTTOMRIGHT">
								<Offset>
									<AbsDimension x="-6" y="-24"/>
								</Offset>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnLoad>
								this:SetValueStepMode("INT")
							</OnLoad>
							<OnValueChanged>
								UIPanelScrollBar_OnValueChanged(this, arg1)
								AAC.Bid.DrawList()
							</OnValueChanged>
						</Scripts>
					</Slider>
					<Button name="AAC_BidHeaderName" inherits="AAC_BidListHeaderTemplate" text="C_ITEM_NAME" id="1">
						<Anchors>
							<Anchor point="TOP">
								<Offset>
									<AbsDimension x="-278" y="6"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidHeaderLevel" inherits="AAC_BidListHeaderTemplate" text="C_LEVEL" id="2">
						<Anchors>
