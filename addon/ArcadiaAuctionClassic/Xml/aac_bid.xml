								</Offset>
							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidListItem13" inherits="AAC_BidListItemTemplate" id="13">
						<Anchors>
							<Anchor point="TOPLEFT" relativeTo="AAC_BidListItem12" relativePoint="BOTTOMLEFT">
								<Offset>
									<AbsDimension x="0" y="4"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Button>
				</Frames>
			</Frame>
			<Button name="AAC_BidListHistoryButton" hidden="true" inherits="UIPanelButtonTemplate" text="AUCTION_HISTORY_PRICE">
				<Size>
					<AbsDimension x="60" y="24"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-52" y="-20"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Button>
			<Button name="AAC_BidListBidButton" inherits="UIPanelButtonTemplate" text="AUCTION_BID">
				<Size>
					<AbsDimension x="60" y="24"/>
				</Size>
				<Anchors>
					<Anchor point="RIGHT" relativeTo="AAC_BidListHistoryButton" relativePoint="LEFT">
						<Offset>
							<AbsDimension x="-4" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						if GetButtonDelayTime() == nil then
							SetButtonDelayTime()
							AAC.Bid.BidSelection(this)
						end
					</OnClick>
				</Scripts>
			</Button>
			<Button name="AAC_BidListBuyoutButton" inherits="UIPanelButtonTemplate" text="AUCTION_BUYOUT">
				<Size>
					<AbsDimension x="60" y="24"/>
				</Size>
				<Anchors>
					<Anchor point="RIGHT" relativeTo="AAC_BidListBidButton" relativePoint="LEFT">
						<Offset>
							<AbsDimension x="-4" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						if GetButtonDelayTime() == nil then
							SetButtonDelayTime()
							AAC.Bid.BuySelection(this)
						end
					</OnClick>
				</Scripts>
			</Button>
			<Frame name="AAC_BidListBidMoneyInput" inherits="AAC_MoneyTemplate">
				<Anchors>
					<Anchor point="RIGHT" relativeTo="AAC_BidListBuyoutButton" relativePoint="LEFT">
						<Offset>
							<AbsDimension x="-25" y="-1"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad>
				AAC.Bid.OnLoad(this)
			</OnLoad>
		</Scripts>
	</Frame>
</Ui>