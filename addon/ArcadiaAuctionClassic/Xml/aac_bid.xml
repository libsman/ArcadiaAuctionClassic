<Ui xmlns="https://chroniclesofarcadia.com/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://chroniclesofarcadia.com/ https://chroniclesofarcadia.com/UI.xsd">
	<Button name="AAC_BidListHeaderTemplate" inherits="AAC_TemplateHeaderButton" virtual="true">
		<Scripts>
			<OnClick>AAC.Bid.ChangeSortMode(this)</OnClick>
		</Scripts>
	</Button>
	<Button name="AAC_BidListItemTemplate" inherits="AAC_TemplateListItem" virtual="true">
		<Size>
			<AbsDimension x="773" y="40"/>
		</Size>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentName" inherits="GameFontNormal" justifyH="LEFT">
					<Size>
						<AbsDimension x="150" y="32"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="46" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentLevel" inherits="GameFontNormal">
					<Size>
						<AbsDimension x="48" y="32"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentName" relativePoint="RIGHT">
							<Offset>
								<AbsDimension x="6" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentLeftTime" inherits="GameFontHighlight">
					<Size>
						<AbsDimension x="74" y="32"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentLevel" relativePoint="RIGHT">
							<Offset>
								<AbsDimension x="6" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentStatus" inherits="GameFontHighlight">
					<Size>
						<AbsDimension x="96" y="32"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentLeftTime" relativePoint="RIGHT">
							<Offset>
								<AbsDimension x="108" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentPPUBid" inherits="GameFontHighlight" justifyH="RIGHT">
					<Size>
						<AbsDimension x="86" y="16"/>
					</Size>
					<Anchors>
						<Anchor point="BOTTOMLEFT" relativeTo="$parentStatus" relativePoint="RIGHT">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentPPUBuy" inherits="GameFontHighlight" justifyH="RIGHT">
					<Size>
						<AbsDimension x="86" y="16"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentStatus" relativePoint="RIGHT">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentIcon" inherits="ItemButtonTemplate">
				<Anchors>
					<Anchor point="LEFT">
						<Offset>
							<AbsDimension x="1" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						AAC.Bid.List_IconClick(this,key)
					</OnClick>
					<OnEnter>
						GameTooltip:SetOwner(this, "ANCHOR_BOTTOMRIGHT")
						GameTooltip:SetAuctionBidItem(AAC.Bid.List.Items[this:GetParent().index].auctionid)
					</OnEnter>
					<OnLeave>
						GameTooltip:Hide()
					</OnLeave>
				</Scripts>
			</Button>
            <Button name="$parentSeller" enableMouse="true">
                <Size>
                    <AbsDimension x="96" y="16"/>
                </Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentLeftTime" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="6" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        this:RegisterForClicks("LeftButton", "RightButton")
                    </OnLoad>
                    <OnClick>
                        AAC.Tools.ClickPlayerName(this, key)
                    </OnClick>
                </Scripts>
                <NormalText inherits="GameFontHighlight">
                    <Size>
                        <AbsDimension x="0" y="16"/>
                    </Size>
                    <Anchors>
                        <Anchor point="CENTER">
                            <Offset>
                                <AbsDimension x="-1" y="-1"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </NormalText>
            </Button>
		</Frames>
		<Scripts>
			<OnClick>
				AAC.Bid.Select(this.index)
			</OnClick>
			<OnMouseWheel>
				UIPanelScrollBar_OnMouseWheel(AAC_BidListScrollBar, delta)
			</OnMouseWheel>
		</Scripts>
	</Button>
	<Frame name="AAC_BidFrame" parent="AAC_AuctionFrame" hidden="true">
		<Frames>
			<Frame name="AAC_BidList">
				<Size>
					<AbsDimension x="803" y="368"/>
				</Size>
				<Anchors>
