							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidListItem8" inherits="AAC_BidListItemTemplate" id="8">
						<Anchors>
							<Anchor point="TOPLEFT" relativeTo="AAC_BidListItem7" relativePoint="BOTTOMLEFT">
								<Offset>
									<AbsDimension x="0" y="4"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidListItem9" inherits="AAC_BidListItemTemplate" id="9">
						<Anchors>
							<Anchor point="TOPLEFT" relativeTo="AAC_BidListItem8" relativePoint="BOTTOMLEFT">
								<Offset>
									<AbsDimension x="0" y="4"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidListItem10" inherits="AAC_BidListItemTemplate" id="10">
						<Anchors>
							<Anchor point="TOPLEFT" relativeTo="AAC_BidListItem9" relativePoint="BOTTOMLEFT">
								<Offset>
									<AbsDimension x="0" y="4"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidListItem11" inherits="AAC_BidListItemTemplate" id="11">
						<Anchors>
							<Anchor point="TOPLEFT" relativeTo="AAC_BidListItem10" relativePoint="BOTTOMLEFT">
								<Offset>
									<AbsDimension x="0" y="4"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidListItem12" inherits="AAC_BidListItemTemplate" id="12">
