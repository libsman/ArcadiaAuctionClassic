							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="10" y="26"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidListItem2" inherits="AAC_BidListItemTemplate" id="2">
						<Anchors>
							<Anchor point="TOPLEFT" relativeTo="AAC_BidListItem1" relativePoint="BOTTOMLEFT">
								<Offset>
									<AbsDimension x="0" y="4"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidListItem3" inherits="AAC_BidListItemTemplate" id="3">
						<Anchors>
							<Anchor point="TOPLEFT" relativeTo="AAC_BidListItem2" relativePoint="BOTTOMLEFT">
								<Offset>
