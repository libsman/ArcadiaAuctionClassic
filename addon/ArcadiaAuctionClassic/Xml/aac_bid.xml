							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidListItem5" inherits="AAC_BidListItemTemplate" id="5">
						<Anchors>
							<Anchor point="TOPLEFT" relativeTo="AAC_BidListItem4" relativePoint="BOTTOMLEFT">
								<Offset>
									<AbsDimension x="0" y="4"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidListItem6" inherits="AAC_BidListItemTemplate" id="6">
