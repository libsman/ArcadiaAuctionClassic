								<Offset>
									<AbsDimension x="0" y="4"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidListItem7" inherits="AAC_BidListItemTemplate" id="7">
						<Anchors>
