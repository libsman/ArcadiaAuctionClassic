								<Offset>
									<AbsDimension x="-165" y="6"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidHeaderLeftTime" inherits="AAC_BidListHeaderTemplate" text="AUCTION_BALANCE_TIME" id="3">
						<Anchors>
							<Anchor point="TOP">
								<Offset>
									<AbsDimension x="-93" y="6"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidHeaderSeller" inherits="AAC_BidListHeaderTemplate" text="AUCTION_SELLER" id="4">
						<Anchors>
							<Anchor point="TOP">
								<Offset>
									<AbsDimension x="-6" y="6"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidHeaderStatus" inherits="AAC_BidListHeaderTemplate" text="AUCTION_COMPETING_SITUATION" id="5">
						<Anchors>
							<Anchor point="TOP">
								<Offset>
									<AbsDimension x="97" y="6"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidHeaderPPU" inherits="AAC_BidListHeaderTemplate" text="price/unit" id="7">
						<Anchors>
							<Anchor point="TOP">
								<Offset>
									<AbsDimension x="205" y="6"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidHeaderPrice" inherits="AAC_BidListHeaderTemplate" text="AUCTION_PRICE" id="6">
						<Anchors>
							<Anchor point="TOP">
								<Offset>
									<AbsDimension x="309" y="6"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Button>
					<Button name="AAC_BidListItem1" inherits="AAC_BidListItemTemplate" id="1">
